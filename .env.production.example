# Copy to .env.production and replace every replace-me value outside version control.
APP_ENV=production
PUBLIC_BASE_URL=https://assistant.example.invalid
DEFAULT_TENANT_SLUG=northstar-auto-care
DEFAULT_TENANT_TIMEZONE=Europe/Moscow
DEFAULT_LOCALE=en
SUPPORTED_LOCALES=en
DATABASE_URL=postgresql+asyncpg://app:replace-me@postgres:5432/business_assistant
POSTGRES_PASSWORD=replace-me
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10
DATABASE_CONNECT_TIMEOUT_SECONDS=10
INTERNAL_API_ENABLED=true
INTERNAL_API_KEY=replace-me-with-at-least-32-random-characters
INTERNAL_API_TENANT_ID=f73f5ad0-05c8-5bc6-a2c7-166b959fa73e
INTERNAL_API_ROLE=viewer
API_REQUEST_TIMEOUT_SECONDS=15
REDIS_ENABLED=true
REDIS_URL=redis://redis:6379/0
CELERY_ENABLED=true
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULTS_ENABLED=false
CELERY_RESULT_BACKEND=
NOTIFICATION_DELIVERY_ENABLED=false
WORKER_BATCH_SIZE=100
WORKER_LEASE_SECONDS=60
WORKER_TASK_SOFT_TIME_LIMIT_SECONDS=300
WORKER_TASK_TIME_LIMIT_SECONDS=330
NOTIFICATION_MAX_ATTEMPTS=6
NOTIFICATION_RETRY_BASE_SECONDS=5
NOTIFICATION_RETRY_MAX_SECONDS=900
TELEGRAM_ENABLED=false
OPENAI_ENABLED=false
AI_ENABLED=false
FEATURE_AI_ENABLED=false
FEATURE_RAG_ENABLED=false
FEATURE_AUTOMATIC_HANDOFF_ENABLED=false
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_INCLUDE_MESSAGE_TEXT=false
METRICS_ENABLED=true
METRICS_AUTH_TOKEN=replace-me-with-at-least-32-random-characters
DEPENDENCY_HEALTH_TIMEOUT_SECONDS=2
UPLOAD_MAX_BYTES=10485760
