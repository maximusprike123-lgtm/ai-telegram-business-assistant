# Safe configuration inventory. Phase 2 migration/seed commands read DATABASE_URL explicitly.
# Copy to .env for local work; .env and all variants except this file are ignored.

# Application
APP_ENV=local
PUBLIC_BASE_URL=http://localhost:8000
DEFAULT_TENANT_SLUG=northstar-auto-care
DEFAULT_TENANT_TIMEZONE=Europe/Moscow
DEFAULT_LOCALE=en
SUPPORTED_LOCALES=en

# Protected Phase 3 internal API — disabled until all three tenant-bound values are supplied
INTERNAL_API_ENABLED=false
INTERNAL_API_KEY=
INTERNAL_API_TENANT_ID=f73f5ad0-05c8-5bc6-a2c7-166b959fa73e
INTERNAL_API_ROLE=viewer
API_HOST=127.0.0.1
API_PORT=8000
API_REQUEST_TIMEOUT_SECONDS=15

# Telegram Phase 4 — disabled by default; values below are safe empty placeholders
TELEGRAM_ENABLED=false
TELEGRAM_DELIVERY_MODE=webhook
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_ID=
TELEGRAM_TENANT_ID=f73f5ad0-05c8-5bc6-a2c7-166b959fa73e
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_PATH_SECRET=
TELEGRAM_WEBHOOK_BASE_URL=
TELEGRAM_UPDATE_MAX_BYTES=1048576
TELEGRAM_CALLBACK_VERSION=1
TELEGRAM_CALLBACK_EXPIRY_SECONDS=900
TELEGRAM_DEDUPLICATION_RETENTION_DAYS=7
TELEGRAM_PROCESSING_STALE_SECONDS=60

# PostgreSQL/pgvector — safe local placeholders; replace only in an ignored .env
DATABASE_URL=postgresql+asyncpg://app@localhost:5432/business_assistant
TEST_DATABASE_URL=postgresql+asyncpg://app@localhost:5432/business_assistant_test
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10
DATABASE_CONNECT_TIMEOUT_SECONDS=10

# Redis and Celery — supplied by later runtime phases
REDIS_URL=
REDIS_ENABLED=false
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CELERY_ENABLED=false
CELERY_RESULTS_ENABLED=false
NOTIFICATION_DELIVERY_ENABLED=false
WORKER_BATCH_SIZE=100
WORKER_LEASE_SECONDS=60
NOTIFICATION_MAX_ATTEMPTS=6
NOTIFICATION_RETRY_BASE_SECONDS=5
NOTIFICATION_RETRY_MAX_SECONDS=900

# Provider-neutral Phase 7 AI runtime — disabled by default
AI_ENABLED=false
AI_PROVIDER=openai
AI_ROUTER_MODEL=
AI_RESPONSE_MODEL=
AI_TEMPERATURE=0
AI_TIMEOUT_SECONDS=8
AI_MAX_RETRIES=2
AI_CONFIDENCE_THRESHOLD=0.8
AI_STRUCTURED_OUTPUT_MODE=strict_json_schema
AI_MAX_OUTPUT_TOKENS=800
AI_INPUT_COST_PER_MILLION=0
AI_OUTPUT_COST_PER_MILLION=0

# OpenAI Responses adapter — leave credentials empty
OPENAI_API_KEY=
OPENAI_ENABLED=false
OPENAI_BASE_URL=https://api.openai.com/v1
# Deprecated compatibility aliases; prefer AI_ROUTER_MODEL and AI_RESPONSE_MODEL
OPENAI_ROUTER_MODEL=
OPENAI_RESPONSE_MODEL=
OPENAI_EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=
AI_MAX_TOOL_ITERATIONS=4

# Phase 8 bounded synchronous Markdown/FAQ knowledge ingestion and retrieval
KNOWLEDGE_CHUNK_MAX_TOKENS=500
KNOWLEDGE_CHUNK_OVERLAP_TOKENS=50
RAG_CANDIDATE_LIMIT=20
RAG_RESULT_LIMIT=4
RAG_MIN_RELEVANCE=0.6
RAG_MAX_ANSWER_CHARACTERS=1800

# Later-phase feature switches remain off
# Deprecated compatibility alias; prefer AI_ENABLED
FEATURE_AI_ENABLED=false
FEATURE_RAG_ENABLED=false
FEATURE_AUTOMATIC_HANDOFF_ENABLED=false

# Runtime signing and encryption — generate unique secrets per environment
CALLBACK_SIGNING_KEY=
CONFIRMATION_SIGNING_KEY=
FIELD_ENCRYPTION_KEY=

# Logging and telemetry
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_INCLUDE_MESSAGE_TEXT=false
OTEL_EXPORTER_OTLP_ENDPOINT=
METRICS_AUTH_TOKEN=

# Upload, retention, and abuse controls
UPLOAD_MAX_BYTES=10485760
OPERATIONAL_METADATA_RETENTION_DAYS=30
MESSAGE_RETENTION_DAYS=90
CUSTOMER_CONTACT_RETENTION_DAYS=365
WORKFLOW_RETENTION_DAYS=730
KNOWLEDGE_ARCHIVE_RETENTION_DAYS=365
AI_TELEMETRY_RETENTION_DAYS=90
RATE_LIMIT_MESSAGES_PER_MINUTE=30
RATE_LIMIT_AI_CALLS_PER_MINUTE=10

# Local portfolio admin bootstrap only; production requires an authenticated principal
ADMIN_BOOTSTRAP_TOKEN=
