# Safe configuration inventory. Phase 2 migration/seed commands read DATABASE_URL explicitly.
# Copy to .env for local work; .env and all variants except this file are ignored.

# Application
APP_ENV=local
PUBLIC_BASE_URL=http://localhost:8000
DEFAULT_TENANT_SLUG=northstar-auto-care
DEFAULT_TENANT_TIMEZONE=Europe/Moscow
DEFAULT_LOCALE=en
SUPPORTED_LOCALES=en

# Protected Phase 3 internal API — disabled until all three tenant-bound values are supplied
INTERNAL_API_ENABLED=false
INTERNAL_API_KEY=
INTERNAL_API_TENANT_ID=f73f5ad0-05c8-5bc6-a2c7-166b959fa73e
INTERNAL_API_ROLE=viewer
API_HOST=127.0.0.1
API_PORT=8000
API_REQUEST_TIMEOUT_SECONDS=15

# Telegram — leave empty until the Telegram phase
TELEGRAM_ENABLED=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_PATH_SECRET=
TELEGRAM_POLLING_ENABLED=false

# PostgreSQL/pgvector — safe local placeholders; replace only in an ignored .env
DATABASE_URL=postgresql+asyncpg://app@localhost:5432/business_assistant
TEST_DATABASE_URL=postgresql+asyncpg://app@localhost:5432/business_assistant_test
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=10
DATABASE_CONNECT_TIMEOUT_SECONDS=10

# Redis and Celery — supplied by later runtime phases
REDIS_URL=
REDIS_ENABLED=false
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CELERY_ENABLED=false
CELERY_RESULTS_ENABLED=false

# OpenAI and task-specific model policy — leave credentials empty
OPENAI_API_KEY=
OPENAI_ENABLED=false
OPENAI_ROUTER_MODEL=
OPENAI_RESPONSE_MODEL=
OPENAI_EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=
AI_MAX_TOOL_ITERATIONS=4
AI_MAX_OUTPUT_TOKENS=800

# Later-phase feature switches remain off
FEATURE_AI_ENABLED=false
FEATURE_RAG_ENABLED=false
FEATURE_AUTOMATIC_HANDOFF_ENABLED=false

# Runtime signing and encryption — generate unique secrets per environment
CALLBACK_SIGNING_KEY=
CONFIRMATION_SIGNING_KEY=
FIELD_ENCRYPTION_KEY=

# Logging and telemetry
LOG_LEVEL=INFO
LOG_FORMAT=json
LOG_INCLUDE_MESSAGE_TEXT=false
OTEL_EXPORTER_OTLP_ENDPOINT=
METRICS_AUTH_TOKEN=

# Upload, retention, and abuse controls
UPLOAD_MAX_BYTES=10485760
MESSAGE_RETENTION_DAYS=90
AI_TELEMETRY_RETENTION_DAYS=90
RATE_LIMIT_MESSAGES_PER_MINUTE=30
RATE_LIMIT_AI_CALLS_PER_MINUTE=10

# Local portfolio admin bootstrap only; production requires an authenticated principal
ADMIN_BOOTSTRAP_TOKEN=
